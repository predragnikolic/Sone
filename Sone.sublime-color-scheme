{
    "name": "Sone Color Scheme",
    "variables": {
        "pure-white": "#ffffff",
        "white": "#D2C1B0",
        "black": "#272320",

        "h-i": "#ffffff03", // inactive highlight
        "h-s": "#ffffff10", // small highlight
        "h-b": "#ffffff40", // big highlight


        "red": "#FF5040",
        "green": "#2AFF95",
        "blue": "#7799FF",
        "purple": "#9977FF",
        "yellow": "#FFEF94",

        "danger": "#FF2C6D",
        "accent": "var(green)",
    },
    "globals": {
        // Global Settings
        "background": "var(black)",
        "foreground": "var(white)",
        "caret": "var(accent)",
        "line_highlight": "var(h-s)",
        // Accents
        "misspelling": "var(red)",
        "fold_marker": "var(h-b)",
        "accent": "var(accent)",
        // Gutter
        "gutter_foreground": "var(h-b)",
        // Selection
        "selection": "#2e2a27", // can't be var(h-s), because of caret 
        "selection_border_width": "1",
        "inactive_selection": "var(h-i)",
        // Find
        "highlight": "var(h-s)",
        "find_highlight": "var(accent)",
        "find_highlight_foreground": "var(h-s)",
        // Guides
        "guide": "var(h-s)",
        "active_guide": "var(white)",
        "stack_guide": "var(h-s)",
        // Brackets
        "brackets_options": "underline",
        "brackets_foreground": "var(accent)",
        "bracket_contents_options":  "underline",
        "bracket_contents_foreground": "var(accent)",
        // Tags
        "tags_options": "underline",
        "tags_foreground": "var(accent)",
        // Shadows
        "shadow": "#00000020",
    },
    "rules": [
        // Comment
        {
            "name": "Comment",
            "scope": "comment",
            "foreground": "var(h-b)"
        },
        // Constant
        {
            "name": "Number",
            "scope": "constant.numeric",
            "foreground": "var(purple)",
        },
        {
            "name": "Character Escape",
            "scope": "constant.character.escape",
            "foreground": "var(purple)",
        },
        {
            "name": "Placeholder",
            "scope": "constant.other.placeholder",
            "foreground": "var(blue)"
        },
        {
            "name": "True Null False",
            "scope": "constant.language",
            "foreground": "var(purple)"
        },
        // Entity
        {
            "name": "Entity",
            "scope": "entity.name",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Tag",
            "scope": "entity.name.tag",
            "foreground": ["var(blue)", "var(purple)"],
            "font_style": "bold"
        },
        {
            "name": "Tags Attribute",
            "scope": "entity.other.attribute-name",
            "foreground": "var(white)",
            "font_style": ""
        },
        {
            "name": "Css Classes And Ids",
            "scope": "source.css entity.other.attribute-name",
            "foreground": ["var(green)", "var(blue)"],
            "font_style": "bold"
        },
        // Invalid
        {
            "name": "Invalid",
            "scope": "invalid",
            "foreground": "var(danger)"
        },
        // Keyword
        {
            "name": "Keyword",
            "scope": "keyword.control",
            "foreground": ["var(green)", "var(blue)"],
            "font_style": "bold"
        },
        {
            "name": "Keyword",
            "scope": "keyword.operator.spread",
            "foreground": ["var(blue)", "var(green)"]
        },
        {
            "name": "Css @Media",
            "scope": "source.css keyword.control",
            "foreground": ["var(red)", "var(yellow)"],
            "font_style": "bold"
        },
        {
            "name": "Css units",
            "scope": "keyword.other.unit",
            "foreground": "var(white)"
        },
        // Markup
        {
            "name": "Inserted",
            "scope": "markup.inserted",
            "foreground": "var(green)"
        },
        {
            "name": "Deleted",
            "scope": "markup.deleted",
            "foreground": "var(danger)"
        },
        {
            "name": "Changed",
            "scope": "markup.changed",
            "foreground": "var(yellow)"
        },
        // Git Gutter Plutgin
        {
            "name": "Untracked gitgutter",
            "scope": "markup.untracked.git_gutter",
            "foreground": "var(h-b)"
        },
        // Git Diff View Plugin
        {
            "name": "Git Diff View Deleted",
            "scope": "text.grf markup.deleted",
            "foreground": ["var(danger)", "#FF6769"],
            "font_style": "bold"
        },
        {
            "name": "Git Diff View Inserted",
            "scope": "source.diff markup.inserted.diff",
            "foreground": ["var(green)", "#70FFE8"],
            "font_style": "bold"
        },
        {
            "name": "Git Diff View Deleted",
            "scope": "source.diff markup.deleted.diff",
            "foreground": ["var(danger)", "#FF6769"],
            "font_style": "bold"
        },
        // Markdown
        {
            "name": "----",
            "scope": "markup.heading",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Markdown Italic",
            "scope": "markup.italic",
            "foreground": "var(pure-white)",
            "font_style": "italic"
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Markdown Strikethrough",
            "scope": "markup.strikethrough",
            "foreground": "var(pure-white)",
        },
        // Markdown Lists
        {
            "name": "Markdown Numbered List",
            "scope": "markup.list.numbered.bullet",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Markdown Unnumbered List",
            "scope": "punctuation.definition.list_item",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Markdown Link",
            "scope": "markup.underline.link",
            "foreground": ["var(blue)", "var(green)"],
            "font_style": "bold"
        },
        {
            "name": "Markdown Link Description",
            "scope": "meta.link.inline.description",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Markdown Link Reference",
            "scope": "meta.link.reference.description",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Markdown Image Description",
            "scope": "meta.image.inline.description",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Markdown Image Reference",
            "scope": "meta.image.reference.description",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        // Markdown Code blocks
        {
            "name": "Markdown Inline Block",
            "scope": "markup.raw.inline",
            "foreground": "var(pure-white)",
            "font_style": "bold",
            "background": "var(h-s)"
        },
        {
            "name": "Markdown Code Block",
            "scope": "markup.raw.code-fence",
            "background": "var(h-s)"
        },
        {
            "name": "Markdown Blockquote",
            "scope": "punctuation.definition.blockquote",
            "foreground": "var(h-s)",
            "font_style": "bold",
            "background": "var(h-b)"
        },
        {
            "name": "Markdown --- *** ",
            "scope": "punctuation.definition.thematic-break",
            "foreground": "var(pure-white)",
            "font_style": "bold",
        },
        // Meta
        {
            "name": "Python Variables",
            "scope": "meta.generic-name",
            "font_style": "bold",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Js Class Property",
            "scope": "meta.property",
            "font_style": "bold",
            "foreground": "var(pure-white)"
        },
        // Punctuation
        {
            "name": "@ Annotation",
            "scope": "punctuation.definition.annotation",
            "font_style": "bold",
            "foreground": "var(purple)"
        },
        {
            "name": "Function Annotation",
            "scope": "variable.annotation",
            "font_style": "bold",
            "foreground": "var(pure-white)"
        },
        // Variable
        {
            "name": "Variable",
            "scope": "variable.other",
            "font_style": "bold",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Variable",
            "scope": "punctuation.definition.variable",
            "font_style": "bold",
            "foreground": ["var(blue)", "var(white)"]
        },
        {
            "name": "Arguments",
            "scope": "variable.parameter",
            "font_style": "bold",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Calling Function Method",
            "scope": "variable.function",
            "font_style": "bold",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Instanciating Classes In Js",
            "scope": "variable.type",
            "font_style": "bold",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Class Attributes And Properties",
            "scope": "variable.other.member",
            "font_style": "bold",
            "foreground": "var(pure-white)"
        },
        // Storage
        {
            "name": "Private Public Mut Keywords",
            "scope": "storage.modifier",
            "font_style": "bold"
        },
        // String
        {
            "name": "String",
            "scope": "string",
            "foreground": "var(pure-white)"
        },
        // Support
        // use App\Class; php
        {
            "name": "Support",
            "scope": "support.class",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Call Functions From Objects",
            "scope": "support.function",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Css Property Names",
            "scope": "support.type",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
        {
            "name": "Rust macros",
            "scope": "support.macro",
            "foreground": "var(pure-white)",
            "font_style": "bold"
        },
    ]
}
