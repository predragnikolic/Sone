{
    "name": "Sone Color Scheme",
    "variables": {
        "white": "#ffffff",
        "gray": "#CCC5C6",
        "black": "#333223", // #1E1B1B, #292430, #192224, #201922

        "h-i": "#ffffff03", // inactive highlight
        "h-s": "#ffffff10", // small highlight
        "h-b": "#ffffff40", // big highlight

        "red": "#ff8792",
        "green": "#81deb1",
        "blue": "#7EAFD9",
        "purple": "#b4b0e4",
        "yellow": "#F6FF96",
        "orange": "#fccb9e",
        "salmon": "#ff9c9c",
        "danger": "#FF7C7C",
        "accent": "#8EE9C2",

        "grad1": "#85CECE",
        "grad2": "#85CECE"
    },
    "globals": {
        // Global Settings
        "background": "var(black)",
        "foreground": "var(white)",
        "caret": "var(yellow)",
        "block_caret": "#896fff99",
        "line_highlight": "var(h-s)",
        // Accents
        "misspelling": "var(purple)",
        "fold_marker": "var(h-b)",
        "accent": "var(accent)",
        // Gutter
        "gutter_foreground": "var(h-b)",
        // Selection
        "selection": "var(h-s)", // can't be var(h-s), because of caret
        "selection_border": "#9977FF77",
        "selection_border_width": "2",
        "inactive_selection": "var(h-s)",
        // Find
        "highlight": "var(h-s)",
        "find_highlight": "var(purple)",
        "find_highlight_foreground": "var(h-s)",
        // Guides
        "guide": "var(h-s)",
        "active_guide": "var(white)",
        "stack_guide": "var(h-s)",
        // Brackets
        "brackets_options": "underline",
        "brackets_foreground": "var(green)",
        "bracket_contents_options":  "underline",
        "bracket_contents_foreground": "var(green)",
        // Tags
        "tags_options": "underline",
        "tags_foreground": "var(white)",
        // Shadows
        "shadow": "#00000020",
    },
    "rules": [
        {
            "name": "PURPLE KIND",
            "scope": "notexistent",
            "foreground": "hsl(300, 30%, 68%)"
        },
        {
            "name": "Parens",
            "scope": "punctuation.section.block, punctuation.section.group., punctuation.section.sequence, punctuation.section.mapping",
            "foreground": "var(gray)"
        },
        // Comment
        {
            "name": "Comment",
            "scope": "comment",
            "foreground": "var(h-b)"
        },
        // Constant
        {
            "name": "Unused",
            "scope": "unused",
            "foreground_adjust": "l(- 40%)",
            "background": "#00000001"
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "foreground": "var(purple)",
        },
        {
            "name": "Character Escape",
            "scope": "constant.character.escape",
            "foreground": "var(purple)",
        },
        // LSP "More" link
        {
            "name": "Placeholder",
            "scope": "constant.other.placeholder",
            "foreground": "var(blue)"
        },
        {
            "name": "True Null False",
            "scope": "constant.language",
            "foreground": "var(purple)"
        },
        // Entity
        {
            "name": "Entity Function",
            "scope": "entity.name.function",
            "foreground": ["var(grad1)", "var(grad2)"],
            "font_style": "bold"
        },
        {
            "name": "Entity Function Python",
            "scope": "variable.function meta.generic-name, entity.name.function meta.generic-name",
            "foreground": ["var(grad1)", "var(grad2)"],
            "font_style": "bold"
        },
        {
            "name": "Tag",
            "scope": "entity.name.tag",
            "foreground": ["var(purple)", "var(blue)"],
            "font_style": "bold"
        },
        {
            "name": "React Tag",
            "scope": " entity.name.tag support.class.component",
            "foreground": ["var(blue)", "var(purple)"],
            "font_style": "bold"
        },
        {
            "name": "Css Classes And Ids",
            "scope": "source.css entity.other.attribute-name",
            "foreground": ["var(green)", "var(blue)"],
            "font_style": "bold"
        },
        // Invalid
        {
            "name": "Invalid",
            "scope": "invalid",
            "foreground": "var(danger)"
        },
        // Keyword
        {
            "name": "Keyword",
            "scope": "keyword",
            "foreground":  "var(salmon)",
            "font_style": "bold"
        },
        // Markup
        {
            "name": "Inserted",
            "scope": "markup.inserted",
            "foreground": "var(green)"
        },
        {
            "name": "Deleted",
            "scope": "markup.deleted",
            "foreground": "var(danger)"
        },
        {
            "name": "Changed",
            "scope": "markup.changed",
            "foreground": "var(yellow)"
        },
        // Git Diff View Plugin
        {
            "name": "Git Diff View Deleted",
            "scope": "text.grf markup.deleted",
            "foreground": ["var(danger)", "#ff9d7c"],

        },
        {
            "name": "Git Diff View Inserted",
            "scope": "source.diff markup.inserted.diff",
            "foreground": ["var(green)", "#70FFE8"],
        },
        {
            "name": "Git Diff View Deleted",
            "scope": "source.diff markup.deleted.diff",
            "foreground": ["var(danger)", "#ff9d7c"],

        },
        // Markdown
        {
            "name": "Markdown Italic",
            "scope": "markup.italic",
            "font_style": "italic"
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold",
        },
        // Markdown Lists
        {
            "name": "Markdown Link",
            "scope": ".link",
            "foreground": "#91E0FF",
        },
        // Markdown Code blocks
        {
            "name": "Markdown Inline Block",
            "scope": "markup.raw.inline, markup.raw.code-fence",
            "background": "var(h-s)"
        },
        {
            "name": "Markdown Blockquote",
            "scope": "punctuation.definition.blockquote",
            "foreground": "var(h-s)",
            "background": "var(h-b)"
        },
        // Punctuation
        {
            "name": "@ Annotation",
            "scope": "punctuation.definition.annotation",
            "foreground": "var(purple)"
        },
        {
            "name": "Function call",
            "scope": "support.function",
            "font_style": "bold",
            "foreground": ["var(grad1)", "var(grad2)"],
        },
        {
            "name": "Function call 2",
            "scope": "meta.function-call variable.function",
            "font_style": "bold",
            "foreground": ["var(grad1)", "var(grad2)"],
        },
        // Variable
        {
            "name": "Variable",
            "scope": "punctuation.definition.variable",
            "foreground": ["var(blue)", "var(white)"]
        },
        {
            "name": "This, Self",
            "scope": "variable.language",
            "font_style": "italic",
            "foreground": "var(orange)"
        },
        // Storage
        {
            "name": "Function",
            "scope": "storage",
            "foreground":  "var(purple)"
        },
        // String
        {
            "name": "String",
            "scope": "string",
            "foreground": "var(orange)"
        },
        {
            "name": "object keys",
            "scope": "meta.mapping.key string.quoted.double",
            "foreground": "var(white)"
        },
        {
            "name": "Used",
            "scope": "region.pinkish",
             // with foreground_adjust a theme can adjust the color of the forground
             // but for that to work you need to set a background. Which in my case is almost transparent, thanks O dat nurd for that trick :)
            "background": "#ffffff10"
        },
    ]
}


