{
    "name": "Sone Color Scheme",
    "variables": {
        "pure-white": "#ffffff",
        "white": "#CCC5C6",
        "black": "#251a22", // #1E1B1B

        "h-i": "#ffffff03", // inactive highlight
        "h-s": "#ffffff10", // small highlight
        "h-b": "#ffffff40", // big highlight

        "red": "#ff8792",
        "green": "#81deb1",
        "blue": "#7EAFD9",
        "purple": "#d4b8ff",
        "yellow": "#F6FF96",
        "orange": "#fccb9e",
        "salmon": "#ff9c9c",
        "danger": "#FC5F8F",
        "accent": "#8EE9C2",

        "grad1": "#85CECE",
        "grad2": "#85CECE"
    },
    "globals": {
        // Global Settings
        "background": "var(black)",
        "foreground": "var(white)",
        "caret": "var(yellow)",
        "block_caret": "#896fff99",
        "line_highlight": "var(h-s)",
        // Accents
        "misspelling": "var(purple)",
        "fold_marker": "var(h-b)",
        "accent": "var(accent)",
        // Gutter
        "gutter_foreground": "var(h-b)",
        // Selection
        "selection": "var(h-s)", // can't be var(h-s), because of caret
        "selection_border": "#9977FF77",
        "selection_border_width": "2",
        "inactive_selection": "var(h-s)",
        // Find
        "highlight": "var(h-s)",
        "find_highlight": "var(purple)",
        "find_highlight_foreground": "var(h-s)",
        // Guides
        "guide": "var(h-s)",
        "active_guide": "var(white)",
        "stack_guide": "var(h-s)",
        // Brackets
        "brackets_options": "underline",
        "brackets_foreground": "var(green)",
        "bracket_contents_options":  "underline",
        "bracket_contents_foreground": "var(green)",
        // Tags
        "tags_options": "underline",
        "tags_foreground": "var(pure-white)",
        // Shadows
        "shadow": "#00000020",
    },
    "rules": [
        // Comment
        {
            "name": "Comment",
            "scope": "comment",
            "foreground": "var(h-b)"
        },
        // Constant
        {
            "name": "Unused",
            "scope": "unused",
            "foreground_adjust": "l(- 40%)",
            "background": "#00000001"
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "foreground": "var(purple)",
        },
        {
            "name": "Character Escape",
            "scope": "constant.character.escape",
            "foreground": "var(purple)",
        },
        {
            "name": "Placeholder",
            "scope": "constant.other.placeholder",
            "foreground": "var(blue)"
        },
        {
            "name": "True Null False",
            "scope": "constant.language",
            "foreground": "var(purple)"
        },
        // Entity
        {
            "name": "Entity",
            "scope": "entity.name",
            "foreground": "var(pure-white)",
        },
        {
            "name": "Entity Function",
            "scope": "entity.name.function",
            "foreground": ["var(grad1)", "var(grad2)"],
            "font_style": "bold"
        },
        {
            "name": "Entity Function Python",
            "scope": "variable.function meta.generic-name, entity.name.function meta.generic-name",
            "foreground": ["var(grad1)", "var(grad2)"],
            "font_style": "bold"
        },
        {
            "name": "Tag",
            "scope": "entity.name.tag",
            "foreground": ["var(purple)", "var(blue)"],
            "font_style": "bold"
        },
        {
            "name": "React Tag",
            "scope": " entity.name.tag support.class.component",
            "foreground": ["var(blue)", "var(purple)"],
            "font_style": "bold"
        },
        {
            "name": "Tags Attribute",
            "scope": "entity.other.attribute-name",
            "foreground": "var(pure-white)",
            "font_style": ""
        },
        {
            "name": "Css Classes And Ids",
            "scope": "source.css entity.other.attribute-name",
            "foreground": ["var(green)", "var(blue)"],
            "font_style": "bold"
        },
        // Invalid
        {
            "name": "Invalid",
            "scope": "invalid",
            "foreground": "var(danger)"
        },
        // Keyword
        {
            "name": "Keyword",
            "scope": "keyword.control",
            "foreground": ["var(green)", "var(blue)"],
            "font_style": "bold"
        },
        {
            "name": "Keyword",
            "scope": "keyword.control.flow",
            "foreground": "var(salmon)",
            "font_style": "bold"
        },
        {
            "name": "Keyword",
            "scope": "keyword.control.conditional",
            "foreground": "var(salmon)",
            "font_style": "bold"
        },
        {
            "name": "Keyword For Spread",
            "scope": "keyword.operator.spread",
            "foreground": ["var(blue)", "var(green)"]
        },
        {
            "name": "Import JS Modules",
            "scope": "keyword.operator.module",
            "foreground": ["var(green)", "var(blue)"],
            "font_style": "bold"
        },
        {
            "name": "Import JS Modules JSCustom",
            "scope": "keyword.control.import-export",
            "foreground": "var(salmon)",
            "font_style": "bold"
        },
        {
            "name": "FROM TS",
            "scope": "keyword.control.from.ts",
            "foreground": "var(salmon)",
            "font_style": "bold"
        },
        {
            "name": "Import JS Modules JSCustom",
            "scope": "keyword.import",
            "foreground": "var(salmon)"
        },
        {
            "name": "Import JS Modules JSCustom",
            "scope": "keyword.control.import",
            "foreground": "var(salmon)",
            "font_style": "bold"
        },
        {
            "name": "Is Not In Pyton",
            "scope": "keyword.operator.logical",
            "foreground": "var(salmon)",
            "font_style": "bold"
        },
        {
            "name": "=",
            "scope": "keyword.operator",
            "foreground": "var(salmon)",
            "font_style": "bold"
        },
        {
            "name": "Css @Media",
            "scope": "source.css keyword.control",
            "foreground": ["var(salmon)", "var(yellow)"],
        },
        {
            "name": "PHP use, new",
            "scope": "keyword.other",
            "foreground": ["var(green)", "var(blue)"],
            "font_style": "bold"
        },
        {
            "name": "Css units",
            "scope": "keyword.other.unit",
            "foreground": "var(orange)"
        },
        // Markup
        {
            "name": "Inserted",
            "scope": "markup.inserted",
            "foreground": "var(green)"
        },
        {
            "name": "Deleted",
            "scope": "markup.deleted",
            "foreground": "var(danger)"
        },
        {
            "name": "Changed",
            "scope": "markup.changed",
            "foreground": "var(yellow)"
        },
        // Git Gutter Plutgin
        {
            "name": "Untracked gitgutter",
            "scope": "markup.untracked.git_gutter",
            "foreground": "var(h-b)"
        },
        // Git Diff View Plugin
        {
            "name": "Git Diff View Deleted",
            "scope": "text.grf markup.deleted",
            "foreground": ["var(danger)", "#FF6769"],

        },
        {
            "name": "Git Diff View Inserted",
            "scope": "source.diff markup.inserted.diff",
            "foreground": ["var(green)", "#70FFE8"],
        },
        {
            "name": "Git Diff View Deleted",
            "scope": "source.diff markup.deleted.diff",
            "foreground": ["var(danger)", "#FF6769"],

        },
        // Markdown
        {
            "name": "----",
            "scope": "markup.heading",
            "foreground": "var(pure-white)",
        },
        {
            "name": "Markdown Italic",
            "scope": "markup.italic",
            "foreground": "var(pure-white)",
            "font_style": "italic"
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold",
            "foreground": "var(pure-white)",
        },
        {
            "name": "Markdown Strikethrough",
            "scope": "markup.strikethrough",
            "foreground": "var(pure-white)",
        },
        // Markdown Lists
        {
            "name": "Markdown Numbered List",
            "scope": "markup.list.numbered.bullet",
            "foreground": "var(pure-white)",
        },
        {
            "name": "Markdown Unnumbered List",
            "scope": "punctuation.definition.list_item",
            "foreground": "var(pure-white)",
        },
        {
            "name": "Markdown Link",
            "scope": ".link",
            "foreground": "#91E0FF",
        },
        {
            "name": "Markdown Link Description",
            "scope": "meta.link.inline.description",
            "foreground": "var(pure-white)",
        },
        {
            "name": "Markdown Link Reference",
            "scope": "meta.link.reference.description",
            "foreground": "var(pure-white)",
        },
        {
            "name": "Markdown Image Description",
            "scope": "meta.image.inline.description",
            "foreground": "var(pure-white)",
        },
        {
            "name": "Markdown Image Reference",
            "scope": "meta.image.reference.description",
            "foreground": "var(pure-white)",
        },
        // Markdown Code blocks
        {
            "name": "Markdown Inline Block",
            "scope": "markup.raw.inline",
            "foreground": "var(pure-white)",
            "background": "var(h-s)"
        },
        {
            "name": "Markdown Code Block",
            "scope": "markup.raw.code-fence",
            "background": "var(h-s)"
        },
        {
            "name": "Markdown Blockquote",
            "scope": "punctuation.definition.blockquote",
            "foreground": "var(h-s)",
            "background": "var(h-b)"
        },
        {
            "name": "Markdown --- *** ",
            "scope": "punctuation.definition.thematic-break",
            "foreground": "var(pure-white)",
        },
        // Meta
        {
            "name": "Python Variables",
            "scope": "meta.generic-name",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Js Class Property",
            "scope": "meta.property",
            "foreground": "var(pure-white)"
        },
        // Punctuation

        {
            "name": "PHp ->",
            "scope": "punctuation.accessor.arrow",
            "foreground": "var(salmon)",
            "font_style": ""
        },
        {
            "name": "PHp ->",
            "scope": "punctuation.accessor",
            "foreground": "var(white)",
            "font_style": ""
        },
        {
            "name": "@ Annotation",
            "scope": "punctuation.definition.annotation",
            "foreground": "var(purple)"
        },
        {
            "name": "Function Annotation",
            "scope": "variable.annotation",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Js Object Key Literal",
            "scope": "meta.object-literal.key",
            "foreground": "var(pure-white)",

        },
        {
            "name": "Function call",
            "scope": "support.function",
            "font_style": "bold",
            "foreground": ["var(grad1)", "var(grad2)"],
        },
        {
            "name": "Function call 2",
            "scope": "meta.function-call variable.function",
            "font_style": "bold",
            "foreground": ["var(grad1)", "var(grad2)"],
        },
        // Variable
        {
            "name": "Variable",
            "scope": "variable.other",
            "foreground": "var(pure-white)",
            "font_style": "",
        },
        {
            "name": "Variable",
            "scope": "punctuation.definition.variable",
            "foreground": ["var(blue)", "var(white)"]
        },
        {
            "name": "Arguments",
            "scope": "variable.parameter",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Calling Function Method",
            "scope": "variable.function",
            "font_style": "bold"
        },
        {
            "name": "Instanciating Classes In Js",
            "scope": "variable.type",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Class Attributes And Properties",
            "scope": "variable.other.member",
            "foreground": "var(pure-white)"
        },
        {
            "name": "This, Self",
            "scope": "variable.language",
            "font_style": "italic",
            "foreground": "var(orange)"
        },
        // Storage
        {
            "name": "Private Public Mut Keywords",
            "scope": "storage.modifier",
            "font_style": "bold",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Php extends",
            "scope": "storage.modifier.extends",
            "foreground": "var(purple)"
        },
        {
            "name": "Function",
            "scope": "storage.type",
            "foreground":  "var(purple)"
        },
        // String
        {
            "name": "String",
            "scope": "string",
            "foreground": "var(orange)"
        },
        {
            "name": "Quotes",
            "scope": "punctuation.definition.string",
            "foreground": "var(pure-white)"
        },
        // Support
        // use App\Class; php
        {
            "name": "Support",
            "scope": "support.class",
            "foreground": "var(pure-white)",
        },
        {
            "name": "Inheritance",
            "scope": "entity.other.inherited-class",
            "foreground": "var(pure-white)",
        },
        {
            "name": "Css Property Names",
            "scope": "support.type, meta.function.parameters.annotation meta.qualified-name meta.generic-name",
            "foreground": "var(white)",
        },
        {
            "name": "Rust macros",
            "scope": "support.macro",
            "foreground": ["var(grad1)", "var(grad2)"],
            "font_style": "bold"
        },
        // grapqhl
        {
            "name": "Type Name",
            "scope": "meta.type.type",
            "foreground": "var(pure-white)",
        },
        {
            "name": "object keys",
            "scope": "meta.mapping.key string.quoted.double",
            "foreground": "var(pure-white)"
        },
        {
            "name": "Used",
            "scope": "region.pinkish",
             // with foreground_adjust a theme can adjust the color of the forground
             // but for that to work you need to set a background. Which in my case is almost transparent, thanks O dat nurd for that trick :)
            "background": "#ffffff10"
        }
    ]
}
