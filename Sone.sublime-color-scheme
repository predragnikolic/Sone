{
    "name": "Sone Color Scheme",
    "variables": {
        "white": "#ccc",
        "gray": "#CCC5C6",
        "black": "#201922", // #160319, #012323, #030819, #192224, #201922, #182220

        "h-i": "#ffffff03", // inactive highlight
        "h-s": "#ffffff20", // small highlight
        "h-b": "#ffffff50", // big highlight
        "gray_1": "#666",
        "gray_2": "#bbbbbb80",
        "gray_3": "#ccc",

        "red": "#ff8792",
        "green": "#81deb1",
        "blue": "#7EAFD9",
        "purple": "#b4b0e4",
        "yellow": "#ebf4a1",
        "orange": "#fccb9e",
        "salmon": "#ff9c9c",
        "danger": "#FF7C7C",
        "accent": "#fccb9e",

        "grad1": "#85CECE",
        "grad2": "#85CECE"
    },
    "globals": {
        // Global Settings
        "background": "var(black)",
        "foreground": "var(white)",
        "caret": "var(yellow)",
        "block_caret": "#896fff99",
        "line_highlight": "var(h-s)",
        // Accents
        "misspelling": "var(purple)",
        "fold_marker": "var(h-b)",
        "accent": "var(accent)",
        // Gutter
        "gutter_foreground": "var(h-b)",
        // Selection
        "selection": "var(h-s)", // can't be var(h-s), because of caret
        "selection_border": "#9977FF77",
        "selection_border_width": "2",
        "inactive_selection": "var(h-s)",
        // Find
        "highlight": "var(h-s)",
        "find_highlight": "var(purple)",
        "find_highlight_foreground": "var(h-s)",
        // Guides
        "guide": "var(h-s)",
        "active_guide": "var(white)",
        "stack_guide": "var(h-s)",
        // Brackets
        "brackets_options": "underline",
        "brackets_foreground": "var(green)",
        "bracket_contents_options":  "underline",
        "bracket_contents_foreground": "var(green)",
        // Tags
        "tags_options": "underline",
        "tags_foreground": "var(white)",
        // Shadows
        "shadow": "#00000020",
    },
    "rules": [
        {
            "name": "PURPLE KIND",
            "scope": "notexistent",
            "foreground": "hsl(300, 30%, 68%)"
        },
        // Comment
        {
            "name": "Comment",
            "font_style": "italic",
            "scope": "comment",
            "foreground": "var(gray_2)"
        },
        {
            "name": "Strings",
            "scope": "punctuation.definition",
            "foreground": "var(gray_2)"
        },
        {
            "name": "Blocks",
            "scope": "punctuation.section.block",
            "foreground": "var(gray_2)"
        },
        {
            "name": "Parens",
            "scope": "punctuation.section.group",
            "foreground": "var(gray_2)"
        },
        {
            "name": "Parens",
            "scope": "punctuation.separator | keyword.operator | keyword | storage",
            "foreground": "var(gray_2)"
        },
        {
            "name": "String",
            "scope": "string.quoted",
            "foreground": "var(orange)"
        },
        {
            "name": "Placeholder",
            "scope": "constant.other.placeholder",
            "foreground": "var(blue)"
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric",
            "foreground": "var(purple)"
        },
        {
            "name": "Numbers",
            "scope": "constant.language.boolean",
            "foreground": "var(purple)"
        },
        // LSP "More" link
        {
            "name": "Placeholder",
            "scope": "constant.other.placeholder",
            "foreground": "var(blue)"
        },
        // Markup
        {
            "name": "Inserted",
            "scope": "markup.inserted",
            "foreground": "var(green)"
        },
        {
            "name": "Deleted",
            "scope": "markup.deleted",
            "foreground": "var(danger)"
        },
        {
            "name": "Changed",
            "scope": "markup.changed",
            "foreground": "var(yellow)"
        },
        // Git Diff View Plugin
        {
            "name": "Git Diff View Deleted",
            "scope": "text.grf markup.deleted",
            "foreground": ["var(danger)", "#ff9d7c"],

        },
        {
            "name": "Git Diff View Inserted",
            "scope": "source.diff markup.inserted.diff",
            "foreground": ["var(green)", "#70FFE8"],
        },
        {
            "name": "Git Diff View Deleted",
            "scope": "source.diff markup.deleted.diff",
            "foreground": ["var(danger)", "#ff9d7c"],

        },
        // Markdown
        {
            "name": "Markdown Italic",
            "scope": "markup.italic",
            "font_style": "italic"
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold",
        },
        // Markdown Lists
        {
            "name": "Markdown Link",
            "scope": ".link",
            "foreground": "#91E0FF",
        },
        // Markdown Code blocks
        {
            "name": "Markdown Inline Block",
            "scope": "markup.raw.inline, markup.raw.code-fence",
            "background": "var(h-s)"
        },
        {
            "name": "Markdown Blockquote",
            "scope": "punctuation.definition.blockquote",
            "foreground": "var(h-s)",
            "background": "var(h-b)"
        },
        // LSP
                {
            "scope": "markup.unnecessary.lsp",
            "foreground_adjust": "l(- 40%)",
            "background": "#00000001"
        },
        {
            "scope": "markup.unnecessary",
            "foreground_adjust": "l(- 40%)",
            "background": "#00000001"
        },
        {
            "scope": "variable.parameter.sighelp.lsp",
            "foreground": "#ffffff80"
        },
        {
            "scope": "variable.parameter.sighelp.active.lsp",
            "foreground": "var(orange)"
        },

        {
            "scope": "markup.highlight",
            "foreground": "color(rgb(255, 255, 255) alpha(0.4))",
            "background": "#ffffff16"
        },
        // git diff view
        // source.diff meta.diff.range.unified meta.range.unified.diff meta.toc-list.line-number.diff
        {
            "scope": "meta.diff.range",
            "foreground": "var(h-b)"
        },
        {
            "scope": "diff.deleted",
            "background": "color(var(red) alpha(0.2))",
            "foreground_adjust": "l(+ 5%)"
        },
        {
            "scope": "diff.deleted.char",
            "background": "color(var(red) alpha(0.5))",
            "foreground_adjust": "l(- 10%)"
        },
        {
            "scope": "diff.inserted",
            "background": "color(var(green) alpha(0.2))",
            "foreground_adjust": "l(+ 5%)"
        },
        {
            "scope": "diff.inserted.char",
            "background": "color(var(green) alpha(0.5))",
            "foreground_adjust": "l(+ 5%)"
        },

    ]
}

